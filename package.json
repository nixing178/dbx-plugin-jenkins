{
  "name": "dbx-plugin-jenkins",
  "private": true,
  "version": "0.13.1",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-version.mjs && vue-tsc --noEmit && vite build",
